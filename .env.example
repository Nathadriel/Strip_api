# Base de données (SQLite pour le TP — un simple fichier)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=un-secret-long-et-aleatoire   # génère-en un avec : openssl rand -base64 32

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers)
# Callback attendue par NextAuth : http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
# Donnée par `stripe listen --forward-to localhost:3000/api/webhook` au lancement
STRIPE_WEBHOOK_SECRET=whsec_...
